export type Options = {\
	name: string?,\
	gui: LayerCollector?,\
	parent: Instance?,\
	theme: { [string]: any }?,\
	displayOrder: number?,\
	ignoreGuiInset: boolean?,\
	resetOnSpawn: boolean?,\
}\
