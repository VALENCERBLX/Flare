		if spec.Indeterminate then\
			refs.Progress:setIndeterminate(true)\
		else\
			refs.Progress:setIndeterminate(false)\
			refs.Progress:setValue(spec.Progress or 0)\
		end\
	end\
end\
\
return Render\
"},
