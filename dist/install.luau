		gap = self.gap,\
		padX = 0,\
		padY = 0,\
\
		chrome = Vector2.zero,\
		room = available,\
\
		minWidth = 0,\
		maxWidth = math.max(1, available.X - self.margin * 2),\
		minHeight = 0,\
		maxHeight = 9999,\
