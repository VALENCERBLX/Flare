			ImageTransparency = theme.transparency.muted,\
			ScaleType = Enum.ScaleType.Fit,\
\
			Size = UDim2.fromOffset(theme.size.icon, theme.size.icon),\
			Name = \"Icon\",\
			Image = \"\",\
		},\
	}) :: ImageLabel\
\
	local fields: Fields = {\
		app = app,\
		scope = scope,\
		instance = root,\
		refs = { root = root },\
		bindings = {},\
		events = {},\
		owner = nil,\
		dead = false,\
\
		kind = \"icon\",\
		desired = Vector2.new(theme.size.icon, theme.size.icon),\
		margin = 0,\
		fill = false,\
		grow = false,\
		enabled = true,\
		measured = false,\
