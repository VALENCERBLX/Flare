	Toast = Kinds.Simple,\
	Banner = Kinds.Simple,\
	Alert = Kinds.Simple,\
	Snackbar = Kinds.Simple,\
	Confirm = Kinds.Simple,\
	Hint = Kinds.Simple,\
	Countdown = Kinds.Simple,\
	Loading = Kinds.Progress,\
	Progress = Kinds.Progress,\
	Choice = Kinds.Choice,\
	Prompt = Kinds.Prompt,\
	Achievement = Kinds.Achievement,\
	Reward = Kinds.Achievement,\
}\
