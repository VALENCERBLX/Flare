--// always a typo for one it does, and swallowing it in silence turns a\
--// one-letter slip into an afternoon of wondering why nothing happened.\
local KnownOptions: { [string]: boolean } = {\
	Theme = true,\
	Tokens = true,\
	App = true,\
	Gui = true,\
	DisplayOrder = true,\
	Anchor = true,\
	Max = true,\
	Duration = true,\
	Durations = true,\
